# Copy to .env.local (git-ignored) and adjust.

# Backend API, no trailing slash. Production (Vercel): the HTTPS Cloud Run URL ending in /api.
VITE_API_URL=http://localhost:8000/api

# true = use the local Firebase Emulator Suite (npm run emulators) instead of the real Firebase project.
VITE_USE_FIREBASE_EMULATORS=false
